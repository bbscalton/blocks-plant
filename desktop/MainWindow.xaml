<Window x:Class="BlocksPlant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocks Plant"
        Height="780" Width="1240"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Dark branded sidebar with kiln-orange rail -->
        <Border Grid.Column="0" Background="#FF0E1418">
            <Grid>
                <Border Width="6" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>
                <DockPanel Margin="6,0,0,0">
                    <Border DockPanel.Dock="Top" Padding="16,22,16,18" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="7" Margin="0,0,12,0"
                                        x:Name="BrandMark">
                                    <Grid>
                                        <Image x:Name="SidebarLogo" Stretch="Uniform" Margin="4" Visibility="Collapsed"/>
                                        <Grid x:Name="DefaultMark">
                                            <Border Width="12" Height="7" Background="White" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,8,0,0" CornerRadius="1"/>
                                            <Border Width="12" Height="7" Background="White" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,8,0,0" CornerRadius="1"/>
                                            <Border Width="12" Height="7" Background="White" Opacity="0.85" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,18,0,0" CornerRadius="1"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="BrandNameLabel" Text="BLOCKS PLANT" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="14" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Operations shell" FontSize="11" Foreground="#8A9AA3"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#33E07020" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="DARK SIDEBAR · KILN ORANGE" FontSize="9" FontWeight="Bold"
                                           Foreground="#FFFFC89A"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12,14" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Border Background="#22FFFFFF" CornerRadius="7" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="UserNameLabel" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3" Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="UserRoleLabel" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Button Content="Sign out" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Click="Logout_Click"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,16,10,8">
                        <StackPanel x:Name="NavPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleLabel" Text="Workspace"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                        <TextBlock x:Name="PageHintLabel" Text="Select a module"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentBrush}"
                            CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock Text="LIVE FLOOR" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </DockPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" Padding="22">
                <ContentControl x:Name="ContentHost"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
