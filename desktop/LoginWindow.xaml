<Window x:Class="BlocksPlant.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocks Plant — Sign in"
        Height="560" Width="920"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{StaticResource SlateBrush}" ClipToBounds="True">
            <Grid>
                <Rectangle Opacity="0.12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE07020" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Concrete block pattern -->
                <Canvas Opacity="0.18" Margin="40,80,0,0">
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="0" Canvas.Top="0"/>
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="80" Canvas.Top="0"/>
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="40" Canvas.Top="44"/>
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="120" Canvas.Top="44"/>
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="0" Canvas.Top="88"/>
                    <Border Width="72" Height="36" Background="{StaticResource ConcreteBrush}" CornerRadius="2" Canvas.Left="80" Canvas.Top="88"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" Margin="48,0,40,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Border Width="40" Height="40" Background="{StaticResource AccentBrush}" CornerRadius="6" Margin="0,0,12,0">
                            <Grid>
                                <Border Width="14" Height="8" Background="White" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,8,0,0" CornerRadius="1"/>
                                <Border Width="14" Height="8" Background="White" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,8,0,0" CornerRadius="1"/>
                                <Border Width="14" Height="8" Background="White" Opacity="0.85" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,20,0,0" CornerRadius="1"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BLOCKS PLANT" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Manufacturing · Sales · Stock" FontSize="12" Foreground="#9AABB4" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Concrete block operations, built for the floor."
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="28" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="36"/>
                    <TextBlock Text="POS, production, materials, and receivables in one calm workspace — ready for a live demo."
                               FontSize="14" Foreground="#A8B6BD" TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="22"/>

                    <StackPanel Orientation="Horizontal" Margin="0,36,0,0">
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="Office POS" Foreground="#E8EEF0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                            <TextBlock Text="Owner dashboard" Foreground="#E8EEF0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="Live stock" Foreground="#E8EEF0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form panel -->
        <Border Grid.Column="1" Background="{StaticResource RaisedBrush}" Padding="48,40">
            <Grid>
                <StackPanel VerticalAlignment="Center" MaxWidth="340" HorizontalAlignment="Stretch">
                    <TextBlock Text="Sign in" FontFamily="{StaticResource DisplayFont}"
                               FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Use your plant account to open the Windows POS."
                               Style="{StaticResource PageSubtitle}" Margin="0,6,0,28"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Height="40" Margin="0,0,0,14" Text="cashier"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,14" Padding="10,8"/>

                    <TextBlock Text="API base URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ApiUrlBox" Height="36" FontSize="12" Margin="0,0,0,20"/>

                    <Button x:Name="LoginButton" Content="Sign in to POS" Height="44" FontSize="14"
                            Style="{StaticResource PrimaryButton}"
                            Click="LoginButton_Click" IsDefault="True"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13"/>
                </StackPanel>

                <TextBlock Text="Blocks Plant · Desktop" VerticalAlignment="Bottom"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
