<Window x:Class="BlocksPlant.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blocks Plant — Sign in"
        Height="600" Width="980"
        MinHeight="540" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel — kiln-dark with orange accent rail -->
        <Border Grid.Column="0" Background="#FF0E1418" ClipToBounds="True">
            <Grid>
                <!-- Thick kiln-orange accent rail -->
                <Border Width="8" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>

                <Rectangle Opacity="0.22">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFE07020" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.5"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Large concrete block stack -->
                <Canvas Opacity="0.28" Margin="56,100,0,0">
                    <Border Width="96" Height="48" Background="{StaticResource ConcreteBrush}" CornerRadius="3" Canvas.Left="0" Canvas.Top="0"/>
                    <Border Width="96" Height="48" Background="{StaticResource ConcreteBrush}" CornerRadius="3" Canvas.Left="108" Canvas.Top="0"/>
                    <Border Width="96" Height="48" Background="{StaticResource AccentBrush}" Opacity="0.85" CornerRadius="3" Canvas.Left="54" Canvas.Top="56"/>
                    <Border Width="96" Height="48" Background="{StaticResource ConcreteBrush}" CornerRadius="3" Canvas.Left="162" Canvas.Top="56"/>
                    <Border Width="96" Height="48" Background="{StaticResource ConcreteBrush}" CornerRadius="3" Canvas.Left="0" Canvas.Top="112"/>
                    <Border Width="96" Height="48" Background="{StaticResource ConcreteBrush}" CornerRadius="3" Canvas.Left="108" Canvas.Top="112"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" Margin="56,0,44,0">
                    <Border Background="#33E07020" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <TextBlock Text="NEW FLOOR UI · 2026" FontSize="11" FontWeight="Bold"
                                   Foreground="#FFFFC89A"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <Border Width="52" Height="52" Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="0,0,14,0">
                            <Grid>
                                <Border Width="16" Height="9" Background="White" Opacity="0.95" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,10,0,0" CornerRadius="1"/>
                                <Border Width="16" Height="9" Background="White" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,10,0,0" CornerRadius="1"/>
                                <Border Width="16" Height="9" Background="White" Opacity="0.85" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="17,24,0,0" CornerRadius="1"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="BLOCKS PLANT" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Manufacturing · Sales · Stock" FontSize="13" Foreground="#9AABB4" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Concrete block operations, built for the floor."
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="32" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" LineHeight="40"/>
                    <TextBlock Text="POS, production, materials, and receivables in one branded workspace — unmistakable from the old gray defaults."
                               FontSize="15" Foreground="#A8B6BD" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="24"/>

                    <StackPanel Orientation="Horizontal" Margin="0,40,0,0">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="5" Padding="12,8" Margin="0,0,10,0">
                            <TextBlock Text="Office POS" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#33FFFFFF" CornerRadius="5" Padding="12,8" Margin="0,0,10,0">
                            <TextBlock Text="Owner dashboard" Foreground="#E8EEF0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#33FFFFFF" CornerRadius="5" Padding="12,8">
                            <TextBlock Text="Live stock" Foreground="#E8EEF0" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form panel — fixed-width column so labels and fields share one edge -->
        <Border Grid.Column="1" Background="{StaticResource RaisedBrush}" Padding="48,44">
            <Grid>
                <StackPanel VerticalAlignment="Center" Width="320" HorizontalAlignment="Center">
                    <TextBlock Text="Sign in" FontFamily="{StaticResource DisplayFont}"
                               FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Use your plant account to open the Windows POS."
                               Style="{StaticResource PageSubtitle}" Margin="0,8,0,28"/>

                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Left"/>
                    <TextBox x:Name="UsernameBox" Width="320" Height="40" Margin="0,0,0,14"
                             HorizontalAlignment="Left" Text="cashier"/>

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Left"/>
                    <PasswordBox x:Name="PasswordBox" Width="320" Height="40" Margin="0,0,0,14"
                                 HorizontalAlignment="Left"/>

                    <TextBlock Text="API base URL" Style="{StaticResource FieldLabel}"
                               HorizontalAlignment="Left"/>
                    <TextBox x:Name="ApiUrlBox" Width="320" Height="40" FontSize="13" Margin="0,0,0,22"
                             HorizontalAlignment="Left"/>

                    <Button x:Name="LoginButton" Content="Sign in to POS" Width="320" Height="48" FontSize="15"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryButton}"
                            Click="LoginButton_Click" IsDefault="True"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0" FontSize="13"
                               Width="320" HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock Text="Blocks Plant · Desktop · Dark kiln shell" VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
