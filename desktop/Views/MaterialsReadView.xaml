<UserControl x:Class="BlocksPlant.Desktop.Views.MaterialsReadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Raw materials" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Read-only on-hand quantities." Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat=0.####}" Width="100"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.####}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
