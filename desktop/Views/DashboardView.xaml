<UserControl x:Class="BlocksPlant.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <DockPanel Margin="0,0,0,8">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Command center" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Today’s production, sales, debtors, and stock at a glance." Style="{StaticResource PageSubtitle}" Margin="0"/>
                </StackPanel>
                <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
            </DockPanel>

            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,18" Height="104">
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="TODAY PRODUCTION" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="ProdText" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="blocks" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="TODAY SALES" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="SalesText" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="gross" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="SALES COUNT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="CountText" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="26" FontWeight="Bold"/>
                        <TextBlock Text="tickets" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0" BorderBrush="#F0C9A0" Background="{StaticResource AccentSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="TOTAL UNPAID" Style="{StaticResource SectionLabel}" Foreground="{StaticResource WarnBrush}"/>
                        <TextBlock x:Name="UnpaidText" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        <TextBlock Text="debtors" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Top" Text="Finished goods stock" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
            <DataGrid x:Name="StockGrid" DockPanel.Dock="Top" Height="180" Margin="0,0,0,18" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="80"/>
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFE7F3EC"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFF0D9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="#FF2F6B4F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Text" Value="Low stock"/>
                                                        <Setter Property="Foreground" Value="#FFB86E00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock DockPanel.Dock="Top" Text="Raw materials" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
            <DataGrid x:Name="MaterialsGrid" Height="200" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat=0.####}" Width="90"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.####}" Width="70"/>
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFE7F3EC"/>
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Padding" Value="8,3"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                    <Setter Property="Background" Value="#FFFFF0D9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="#FF2F6B4F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Text" Value="Low stock"/>
                                                        <Setter Property="Foreground" Value="#FFB86E00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
