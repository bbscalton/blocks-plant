<UserControl x:Class="BlocksPlant.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <DockPanel Margin="0,0,0,8">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Owner dashboard" FontSize="20" FontWeight="SemiBold"/>
                <Button Content="Refresh" HorizontalAlignment="Right" Click="Refresh_Click"/>
            </DockPanel>

            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,0,16" Height="90">
                <Border Background="White" Margin="0,0,8,0" Padding="12" BorderBrush="#D0D5CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today production" Foreground="#666"/>
                        <TextBlock x:Name="ProdText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Margin="0,0,8,0" Padding="12" BorderBrush="#D0D5CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today sales" Foreground="#666"/>
                        <TextBlock x:Name="SalesText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Margin="0,0,8,0" Padding="12" BorderBrush="#D0D5CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sales count" Foreground="#666"/>
                        <TextBlock x:Name="CountText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="12" BorderBrush="#D0D5CC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total unpaid" Foreground="#666"/>
                        <TextBlock x:Name="UnpaidText" FontSize="22" FontWeight="Bold" Foreground="#8B3A3A"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock DockPanel.Dock="Top" Text="Finished goods stock" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="StockGrid" DockPanel.Dock="Top" Height="160" Margin="0,0,0,16" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock DockPanel.Dock="Top" Text="Raw materials" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
            <DataGrid x:Name="MaterialsGrid" Height="180" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat=0.####}" Width="90"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.####}" Width="70"/>
                    <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
