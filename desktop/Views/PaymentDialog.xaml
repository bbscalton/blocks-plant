<Window x:Class="BlocksPlant.Desktop.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment" Height="260" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource RaisedBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="Record payment" Style="{StaticResource PageTitle}" FontSize="18"/>
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AmountBox" Margin="0,0,0,16" Height="40" FontSize="16" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save payment" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
