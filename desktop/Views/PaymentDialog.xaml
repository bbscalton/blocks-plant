<Window x:Class="BlocksPlant.Desktop.Views.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment" Height="240" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Amount"/>
        <TextBox x:Name="AmountBox" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save payment" IsDefault="True" Background="#3D5A40" Foreground="White"
                    BorderThickness="0" Padding="12,6" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#A33" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
