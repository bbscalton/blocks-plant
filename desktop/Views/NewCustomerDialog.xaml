<Window x:Class="BlocksPlant.Desktop.Views.NewCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New customer" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource RaisedBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="New customer" Style="{StaticResource PageTitle}" FontSize="18" Margin="0,0,0,14"/>
        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10" Height="36"/>
        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PhoneBox" Margin="0,0,0,10" Height="36"/>
        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AddressBox" Margin="0,0,0,16" Height="36"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
