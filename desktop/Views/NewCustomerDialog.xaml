<Window x:Class="BlocksPlant.Desktop.Views.NewCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New customer" Height="280" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,8"/>
        <TextBlock Text="Phone"/>
        <TextBox x:Name="PhoneBox" Margin="0,4,0,8"/>
        <TextBlock Text="Address"/>
        <TextBox x:Name="AddressBox" Margin="0,4,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" IsDefault="True" Padding="16,6" Background="#3D5A40" Foreground="White"
                    BorderThickness="0" Click="Save_Click"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#A33" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
