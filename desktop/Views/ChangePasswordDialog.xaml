<Window x:Class="BlocksPlant.Desktop.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Change your password" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="CurrentBox" Height="40"/>
        <TextBlock Text="New password" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="NewBox" Height="40"/>
        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Height="40"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Height="36" Padding="14,0" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Height="36" Padding="16,0"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
