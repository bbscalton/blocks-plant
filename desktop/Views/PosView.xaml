<UserControl x:Class="BlocksPlant.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Point of Sale" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="ProductCombo" Width="220" DisplayMemberPath="Name"/>
                <TextBox x:Name="QtyBox" Width="70" Margin="8,0,0,0" Text="1" VerticalContentAlignment="Center"/>
                <Button Content="Add" Margin="8,0,0,0" Padding="14,6" Click="AddLine_Click"
                        Background="#3D5A40" Foreground="White" BorderThickness="0"/>
            </StackPanel>
            <DataGrid x:Name="LinesGrid" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice, StringFormat=C}" Width="80"/>
                    <DataGridTextColumn Header="Line" Binding="{Binding LineTotal, StringFormat=C}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Checkout" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock x:Name="GrandTotalText" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" Text="Total: $0.00"/>

                <TextBlock Text="Fulfillment" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <RadioButton x:Name="CollectRadio" Content="Collect" IsChecked="True" Checked="Fulfillment_Changed"/>
                    <RadioButton x:Name="DeliverRadio" Content="Deliver" Margin="16,0,0,0" Checked="Fulfillment_Changed"/>
                </StackPanel>
                <TextBox x:Name="DeliveryAddressBox" Margin="0,0,0,6" Visibility="Collapsed"
                         ToolTip="Delivery address"/>
                <TextBox x:Name="DeliveryNotesBox" Margin="0,0,0,12" Visibility="Collapsed"
                         ToolTip="Delivery notes"/>

                <TextBlock Text="Payment" FontWeight="SemiBold"/>
                <StackPanel Margin="0,4,0,8">
                    <RadioButton x:Name="PayFullRadio" Content="Cash (full)" IsChecked="True" Checked="Payment_Changed"/>
                    <RadioButton x:Name="PayPartialRadio" Content="Partial payment" Checked="Payment_Changed"/>
                    <RadioButton x:Name="PayCreditRadio" Content="Credit (pay later)" Checked="Payment_Changed"/>
                </StackPanel>
                <TextBlock Text="Amount paid"/>
                <TextBox x:Name="AmountPaidBox" Margin="0,4,0,12" IsEnabled="False"/>

                <TextBlock Text="Customer" FontWeight="SemiBold"/>
                <ComboBox x:Name="CustomerCombo" Margin="0,4,0,6" DisplayMemberPath="Name"/>
                <Button Content="New customer…" Margin="0,0,0,12" Click="NewCustomer_Click"/>

                <Button Content="Complete sale" Height="40" FontWeight="SemiBold"
                        Background="#3D5A40" Foreground="White" BorderThickness="0"
                        Click="CompleteSale_Click"/>
                <Button Content="Clear" Margin="0,8,0,0" Click="Clear_Click"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#335"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
