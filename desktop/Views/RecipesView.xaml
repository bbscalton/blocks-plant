<UserControl x:Class="BlocksPlant.Desktop.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Product recipes (BOM)" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Quantity of each raw material consumed per good block. Rejects do not consume extra."
                       Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource PanelCard}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Product" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProductCombo" Width="240" DisplayMemberPath="ProductName" Height="40"
                          SelectionChanged="ProductCombo_SelectionChanged"/>
                <Button Content="Reload" Margin="12,0,0,0" Click="Reload_Click"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Orientation="Horizontal">
            <Button Content="Save recipe" Height="40" Width="140" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      IsReadOnly="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qty per block" Binding="{Binding QuantityPerBlock, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
