<UserControl x:Class="BlocksPlant.Desktop.Views.StockAdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelCard}" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="Stock adjustment" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Owner only. Use positive or negative delta (e.g. -10 for write-off)."
                           Style="{StaticResource PageSubtitle}"/>

                <TextBlock Text="Product" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ProductCombo" Margin="0,0,0,12" DisplayMemberPath="ProductName" Height="40"/>

                <TextBlock Text="Quantity delta" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DeltaBox" Margin="0,0,0,12" Text="0" Height="40" FontSize="16" FontWeight="SemiBold"/>

                <TextBlock Text="Reason (optional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReasonBox" Margin="0,0,0,16" Height="40"/>

                <Button Content="Apply adjustment" Height="44" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelCard}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Current stock" FontWeight="SemiBold"
                           FontSize="14" Margin="16,14,16,10"/>
                <DataGrid x:Name="StockGrid" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
