<UserControl x:Class="BlocksPlant.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Customers" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox x:Name="SearchBox" Width="180" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
                <Button Content="Search" Margin="0,0,8,0" Click="Search_Click"/>
                <Button Content="Debtors only" Margin="0,0,8,0" Click="Debtors_Click"/>
                <Button Content="New customer" Margin="0,0,8,0" Click="New_Click"/>
                <Button Content="Record payment" Background="#3D5A40" Foreground="White" BorderThickness="0"
                        Click="Payment_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
        <DataGrid x:Name="Grid" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
