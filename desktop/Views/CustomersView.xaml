<UserControl x:Class="BlocksPlant.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Customers" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Search, filter debtors, and record payments." Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Width="180" Margin="0,0,8,0" Height="40"/>
                <Button Content="Search" Margin="0,0,8,0" Click="Search_Click"/>
                <Button Content="Debtors only" Margin="0,0,8,0" Click="Debtors_Click"/>
                <Button Content="New customer" Margin="0,0,8,0" Click="New_Click"/>
                <Button Content="Record payment" Style="{StaticResource PrimaryButton}" Click="Payment_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" SelectionMode="Single" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
