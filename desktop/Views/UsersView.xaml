<UserControl x:Class="BlocksPlant.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="User accounts" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Create staff accounts, set roles, reset passwords, and deactivate users."
                       Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Add / edit user" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Username (new only)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Height="40" Margin="0,0,0,8"/>
                    <TextBlock Text="Full name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FullNameBox" Height="40" Margin="0,0,0,8"/>
                    <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="RoleBox" Height="40" Margin="0,0,0,8">
                        <ComboBoxItem Content="Owner"/>
                        <ComboBoxItem Content="Cashier" IsSelected="True"/>
                        <ComboBoxItem Content="Operator"/>
                    </ComboBox>
                    <TextBlock Text="Password (create / leave blank when editing)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ActiveCheck" Content="Active" IsChecked="True" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add new" Style="{StaticResource PrimaryButton}" Height="40" Padding="14,0"
                                Margin="0,0,8,0" Click="Add_Click"/>
                        <Button Content="Save selected" Height="40" Padding="14,0" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Selected user actions" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Reset password" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ResetPasswordBox" Height="40" Margin="0,0,0,8"/>
                    <Button Content="Reset password" Height="40" Padding="14,0" Margin="0,0,0,12"
                            HorizontalAlignment="Left" Click="ResetPassword_Click"/>
                    <Button Content="Deactivate selected" Height="40" Padding="14,0"
                            HorizontalAlignment="Left" Click="Deactivate_Click"/>
                    <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged"
                      AutoGenerateColumns="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
