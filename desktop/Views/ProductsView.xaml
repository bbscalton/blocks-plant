<UserControl x:Class="BlocksPlant.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Products &amp; prices" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Price" VerticalAlignment="Center"/>
            <TextBox x:Name="PriceBox" Width="100" Margin="8,0,16,0"/>
            <TextBlock Text="Min stock" VerticalAlignment="Center"/>
            <TextBox x:Name="MinStockBox" Width="80" Margin="8,0,16,0"/>
            <Button Content="Save selected" Background="#3D5A40" Foreground="White" BorderThickness="0"
                    Click="Save_Click"/>
            <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <DataGrid x:Name="Grid" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeInches}" Width="60"/>
                <DataGridTextColumn Header="Price" Binding="{Binding PricePerBlock, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="70"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding Quantity}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
