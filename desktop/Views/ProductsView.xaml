<UserControl x:Class="BlocksPlant.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Products &amp; prices" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Update unit price and minimum stock for each block size." Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Price" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="PriceBox" Width="110" Margin="0,0,16,0" Height="36"/>
                <TextBlock Text="Min stock" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="MinStockBox" Width="90" Margin="0,0,16,0" Height="36"/>
                <Button Content="Save selected" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeInches}" Width="60"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding PricePerBlock, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock}" Width="70"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding Quantity}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
