<UserControl x:Class="BlocksPlant.Desktop.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Raw materials" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock DockPanel.Dock="Top" Text="Inventory of cement, sand, aggregate, etc. Receive deliveries or adjust stock."
                   Foreground="#555" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D0D5CC" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Add / edit material" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Name"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,8"/>
                    <TextBlock Text="Unit (bags, tons, kg, m³…)"/>
                    <TextBox x:Name="UnitBox" Margin="0,4,0,8"/>
                    <TextBlock Text="Min stock"/>
                    <TextBox x:Name="MinBox" Margin="0,4,0,8" Text="0"/>
                    <TextBlock Text="Initial qty (new only)"/>
                    <TextBox x:Name="QtyBox" Margin="0,4,0,8" Text="0"/>
                    <TextBlock Text="Notes"/>
                    <TextBox x:Name="NotesBox" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add new" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Background="#3D5A40" Foreground="White" BorderThickness="0" Click="Add_Click"/>
                        <Button Content="Save selected" Height="32" Padding="12,0"
                                Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Receive / adjust selected" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Receive quantity (delivery in)"/>
                    <TextBox x:Name="ReceiveBox" Margin="0,4,0,8" Text="0"/>
                    <TextBlock Text="Receive notes"/>
                    <TextBox x:Name="ReceiveNotesBox" Margin="0,4,0,8"/>
                    <Button Content="Receive stock" Height="32" Padding="12,0" Margin="0,0,0,16"
                            Background="#3D5A40" Foreground="White" BorderThickness="0" Click="Receive_Click"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="Adjust delta (+/−)"/>
                    <TextBox x:Name="AdjustBox" Margin="0,4,0,8" Text="0"/>
                    <TextBlock Text="Adjust notes"/>
                    <TextBox x:Name="AdjustNotesBox" Margin="0,4,0,8"/>
                    <Button Content="Apply adjust" Height="32" Padding="12,0"
                            Click="Adjust_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="Grid" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat=0.####}" Width="90"/>
                <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.####}" Width="80"/>
                <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="50"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
