<UserControl x:Class="BlocksPlant.Desktop.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Raw materials" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Cement, sand, aggregate — receive deliveries or adjust stock." Style="{StaticResource PageSubtitle}" Margin="0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Add / edit material" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Height="40" Margin="0,0,0,10"/>
                    <TextBlock Text="Unit (bags, tons, kg, m³…)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UnitBox" Height="40" Margin="0,0,0,10"/>
                    <TextBlock Text="Min stock" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MinBox" Height="40" Margin="0,0,0,10" Text="0"/>
                    <TextBlock Text="Initial qty (new only)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="QtyBox" Height="40" Margin="0,0,0,10" Text="0"/>
                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NotesBox" Height="40" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add new" Height="40" Padding="14,0" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButton}" Click="Add_Click"/>
                        <Button Content="Save selected" Height="40" Padding="14,0" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Receive / adjust selected" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="Receive quantity (delivery in)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ReceiveBox" Height="40" Margin="0,0,0,10" Text="0"/>
                    <TextBlock Text="Receive notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ReceiveNotesBox" Height="40" Margin="0,0,0,10"/>
                    <Button Content="Receive stock" Height="40" Padding="14,0" Margin="0,0,0,16"
                            Style="{StaticResource PrimaryButton}" Click="Receive_Click"
                            HorizontalAlignment="Left"/>
                    <TextBlock Text="Adjust delta (+/−)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AdjustBox" Height="40" Margin="0,0,0,10" Text="0"/>
                    <TextBlock Text="Adjust notes" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="AdjustNotesBox" Height="40" Margin="0,0,0,10"/>
                    <Button Content="Apply adjust" Height="40" Padding="14,0"
                            Click="Adjust_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" SelectionMode="Single" SelectionChanged="Grid_SelectionChanged"
                      AutoGenerateColumns="False" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QuantityOnHand, StringFormat=0.####}" Width="90"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding MinStock, StringFormat=0.####}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Low" Binding="{Binding IsLow}" Width="50"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
