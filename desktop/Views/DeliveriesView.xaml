<UserControl x:Class="BlocksPlant.Desktop.Views.DeliveriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Pending deliveries" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Orders waiting to leave the yard." Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="Mark delivered" Style="{StaticResource PrimaryButton}" Click="MarkDelivered_Click"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" SelectionMode="Single" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sale #" Binding="{Binding SaleId}" Width="70"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding DeliveryAddress}" Width="2*"/>
                    <DataGridTextColumn Header="Notes" Binding="{Binding DeliveryNotes}" Width="*"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=g}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
