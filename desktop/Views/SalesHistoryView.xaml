<UserControl x:Class="BlocksPlant.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Sales history" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Recent POS tickets with payment balance." Style="{StaticResource PageSubtitle}" Margin="0"/>
            </StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Foreground="{StaticResource MutedBrush}"/>
        <Border Style="{StaticResource PanelCard}" Padding="0">
            <DataGrid x:Name="Grid" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="120"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding FulfillmentType}" Width="80"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding BalanceDue, StringFormat=C}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
