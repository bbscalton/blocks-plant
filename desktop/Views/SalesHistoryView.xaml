<UserControl x:Class="BlocksPlant.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Sales history" FontSize="20" FontWeight="SemiBold"/>
            <Button Content="Refresh" HorizontalAlignment="Right" Click="Refresh_Click"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
        <DataGrid x:Name="Grid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, StringFormat=g}" Width="140"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding FulfillmentType}" Width="80"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Due" Binding="{Binding BalanceDue, StringFormat=C}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
