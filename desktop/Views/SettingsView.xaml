<UserControl x:Class="BlocksPlant.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Plant settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Store information, logo, receipt layout, and database backup."
                       Style="{StaticResource PageSubtitle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <TextBlock Text="Store / plant information" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Business name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameBox" Height="40" Margin="0,0,0,10"/>
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AddressBox" Height="40" Margin="0,0,0,10"/>
                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PhoneBox" Height="40" Margin="0,0,0,10"/>
                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="EmailBox" Height="40" Margin="0,0,0,10"/>
                        <TextBlock Text="Tax / VAT ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TaxIdBox" Height="40" Margin="0,0,0,10"/>
                        <TextBlock Text="Receipt footer / thank-you line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="FooterBox" Height="40" Margin="0,0,0,14"/>

                        <TextBlock Text="Receipt fields" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ShowLogoCheck" Content="Show logo" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowNameCheck" Content="Show store name" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowAddressCheck" Content="Show address" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowPhoneCheck" Content="Show phone" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowCashierCheck" Content="Show cashier" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ShowThankYouCheck" Content="Show thank-you / footer" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save settings" Style="{StaticResource PrimaryButton}"
                                    Height="40" Padding="16,0" Click="Save_Click"/>
                            <Button Content="Change my password" Height="40" Padding="14,0" Margin="10,0,0,0"
                                    Click="ChangePassword_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Logo" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushKey}"
                                    BorderThickness="1" Height="120" CornerRadius="6" Margin="0,0,0,10">
                                <Image x:Name="LogoPreview" Stretch="Uniform" Margin="8"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Upload logo" Height="36" Padding="12,0" Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButton}" Click="UploadLogo_Click"/>
                                <Button Content="Remove" Height="36" Padding="12,0" Click="ClearLogo_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Receipt preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Backup" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Download a timestamped copy of the SQLite database. Restore overwrites all live data."
                                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,10"/>
                            <Button Content="Backup now" Style="{StaticResource PrimaryButton}"
                                    Height="40" Padding="14,0" HorizontalAlignment="Left"
                                    Click="Backup_Click" Margin="0,0,0,8"/>
                            <Button Content="Restore from file…" Height="40" Padding="14,0"
                                    HorizontalAlignment="Left" Click="Restore_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
