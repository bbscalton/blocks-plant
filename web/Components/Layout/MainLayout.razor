@using BlocksPlant.Web.Services
@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

@if (!_ready)
{
    <div class="loading-screen">Loading…</div>
}
else if (!Auth.IsAuthenticated)
{
    @Body
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>
        <main>
            <div class="top-row">
                <div class="user-chip">
                    <strong>@Auth.User?.FullName</strong>
                    <span class="role-badge">@Auth.Role</span>
                </div>
                <button class="btn btn-sm btn-outline" @onclick="LogoutAsync">Sign out</button>
            </div>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        // ProtectedSessionStorage requires JS interop — only safe after first interactive render.
        await Auth.InitializeAsync();
        Auth.Changed += OnAuthChanged;
        _ready = true;
        StateHasChanged();
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
