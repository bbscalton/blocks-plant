@page "/users"
@using BlocksPlant.Web.Models
@using BlocksPlant.Web.Services
@using BlocksPlant.Web.Components.Shared
@inject ApiClient Api
@inject AuthService Auth

<PageTitle>Users — Blocks Plant</PageTitle>

<AuthorizeView Roles="Owner">
    <div class="page-header">
        <div>
            <h1>User accounts</h1>
            <p class="muted">Create staff, set roles, reset passwords, deactivate (last Owner protected)</p>
        </div>
        <button class="btn btn-outline" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_loading && _users.Count == 0)
    {
        <div class="loading-inline"><span class="loading-dot"></span> Loading users…</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Full name</th>
                        <th>Role</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _users)
                    {
                        <tr>
                            <td>@u.Username</td>
                            <td>@u.FullName</td>
                            <td><span class="role-badge">@u.Role</span></td>
                            <td>@(u.IsActive ? "Yes" : "No")</td>
                            <td class="btn-row">
                                <button class="btn btn-sm btn-outline" @onclick="() => BeginEdit(u)">Edit</button>
                                <button class="btn btn-sm btn-outline" @onclick="() => BeginReset(u)">Reset PW</button>
                                @if (u.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => DeactivateAsync(u)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="panel" style="margin-top:1.25rem">
        <h2 class="section-title" style="margin-top:0">@(_editId is null ? "Add user" : "Edit user")</h2>
        <div class="form-row">
            <div class="form-group">
                <label>Username</label>
                <InputText class="form-control" @bind-Value="_formUsername" disabled="@(_editId is not null)" />
            </div>
            <div class="form-group">
                <label>Full name</label>
                <InputText class="form-control" @bind-Value="_formFullName" />
            </div>
            <div class="form-group">
                <label>Role</label>
                <InputSelect class="form-control" @bind-Value="_formRole">
                    <option value="Owner">Owner</option>
                    <option value="Cashier">Cashier</option>
                    <option value="Operator">Operator</option>
                </InputSelect>
            </div>
            @if (_editId is null)
            {
                <div class="form-group">
                    <label>Password</label>
                    <InputText type="password" class="form-control" @bind-Value="_formPassword" />
                </div>
            }
            else
            {
                <div class="form-group">
                    <label>Active</label>
                    <label class="check-row"><InputCheckbox @bind-Value="_formActive" /> Active account</label>
                </div>
            }
        </div>
        <div class="btn-row">
            @if (_editId is null)
            {
                <button class="btn btn-primary" @onclick="CreateAsync">Create</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="SaveEditAsync">Save</button>
                <button class="btn btn-outline" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </div>

    @if (_resetId is not null)
    {
        <div class="panel" style="margin-top:1rem">
            <h2 class="section-title" style="margin-top:0">Reset password for @_resetUsername</h2>
            <div class="form-row">
                <div class="form-group">
                    <label>New password</label>
                    <InputText type="password" class="form-control" @bind-Value="_resetPassword" />
                </div>
            </div>
            <div class="btn-row">
                <button class="btn btn-primary" @onclick="ResetPasswordAsync">Reset</button>
                <button class="btn btn-outline" @onclick="() => { _resetId = null; }">Cancel</button>
            </div>
        </div>
    }
</AuthorizeView>

@code {
    private List<UserDto> _users = new();
    private string? _error;
    private string? _message;
    private bool _loading = true;
    private bool _loaded;

    private int? _editId;
    private string _formUsername = string.Empty;
    private string _formFullName = string.Empty;
    private string _formRole = "Cashier";
    private string _formPassword = string.Empty;
    private bool _formActive = true;

    private int? _resetId;
    private string _resetUsername = string.Empty;
    private string _resetPassword = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded = true;
        try
        {
            if (!Auth.IsAuthenticated) await Auth.InitializeAsync();
            if (Auth.IsOwner) await LoadAsync();
            else
            {
                _loading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _users = await Api.GetUsersAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BeginEdit(UserDto u)
    {
        _editId = u.Id;
        _formUsername = u.Username;
        _formFullName = u.FullName;
        _formRole = u.Role;
        _formActive = u.IsActive;
        _resetId = null;
    }

    private void CancelEdit()
    {
        _editId = null;
        _formUsername = string.Empty;
        _formFullName = string.Empty;
        _formRole = "Cashier";
        _formPassword = string.Empty;
        _formActive = true;
    }

    private void BeginReset(UserDto u)
    {
        _resetId = u.Id;
        _resetUsername = u.Username;
        _resetPassword = string.Empty;
        _editId = null;
    }

    private async Task CreateAsync()
    {
        _error = null;
        _message = null;
        try
        {
            await Api.CreateUserAsync(_formUsername, _formPassword, _formFullName, _formRole);
            _message = "User created.";
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task SaveEditAsync()
    {
        if (_editId is null) return;
        _error = null;
        _message = null;
        try
        {
            await Api.UpdateUserAsync(_editId.Value, _formFullName, _formRole, _formActive);
            _message = "User updated.";
            CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (_resetId is null) return;
        _error = null;
        _message = null;
        try
        {
            await Api.ResetUserPasswordAsync(_resetId.Value, _resetPassword);
            _message = "Password reset.";
            _resetId = null;
            _resetPassword = string.Empty;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        StateHasChanged();
    }

    private async Task DeactivateAsync(UserDto u)
    {
        _error = null;
        _message = null;
        try
        {
            await Api.DeactivateUserAsync(u.Id);
            _message = $"Deactivated {u.Username}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
    }
}
