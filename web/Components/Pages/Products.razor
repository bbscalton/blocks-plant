@page "/products"
@using BlocksPlant.Web.Models
@using BlocksPlant.Web.Services
@using BlocksPlant.Web.Components.Shared
@inject ApiClient Api
@inject AuthService Auth

<PageTitle>Products — Blocks Plant</PageTitle>

<AuthorizeView Roles="Owner">
    <div class="page-header">
        <div>
            <h1>Products</h1>
            <p class="muted">Prices, minimum stock, and activate / deactivate catalog items</p>
        </div>
        <div class="btn-row">
            <label class="check-row" style="margin:0">
                <InputCheckbox Value="_includeInactive" ValueChanged="OnIncludeInactiveChanged" /> Show inactive
            </label>
            <button class="btn btn-outline" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success">@_message</div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_loading && _items.Count == 0)
    {
        <div class="loading-inline"><span class="loading-dot"></span> Loading products…</div>
    }
    else if (_items.Count == 0)
    {
        <div class="state-panel">
            <strong>No products yet</strong>
            Products appear here once the plant catalog is seeded.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Size</th>
                        <th>On hand</th>
                        <th>Price / block</th>
                        <th>Min stock</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _items)
                    {
                        <tr class="@(p.IsActive ? null : "row-muted")">
                            <td>@p.Name</td>
                            <td>@p.SizeInches"</td>
                            <td>@p.Quantity</td>
                            <td>
                                <InputNumber class="form-control form-control-sm input-narrow" @bind-Value="p.PricePerBlock" />
                            </td>
                            <td>
                                <InputNumber class="form-control form-control-sm input-narrow" @bind-Value="p.MinStock" />
                            </td>
                            <td>@(p.IsActive ? "Yes" : "No")</td>
                            <td class="btn-row">
                                <button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(p)" disabled="@_saving">Save</button>
                                @if (p.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => DeleteAsync(p)" disabled="@_saving">Remove</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline" @onclick="() => ActivateAsync(p)" disabled="@_saving">Reactivate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="panel" style="margin-top:1.25rem">
        <h2 class="section-title" style="margin-top:0">Add product</h2>
        <div class="form-row">
            <div class="form-group">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="_newName" />
            </div>
            <div class="form-group">
                <label>Size (inches)</label>
                <InputNumber class="form-control" @bind-Value="_newSize" />
            </div>
            <div class="form-group">
                <label>Price</label>
                <InputNumber class="form-control" @bind-Value="_newPrice" />
            </div>
            <div class="form-group">
                <label>Min stock</label>
                <InputNumber class="form-control" @bind-Value="_newMin" />
            </div>
        </div>
        <button class="btn btn-primary" @onclick="AddAsync" disabled="@_saving">Add product</button>
    </div>
</AuthorizeView>

@code {
    private List<ProductDto> _items = new();
    private string? _error;
    private string? _message;
    private bool _loading = true;
    private bool _loaded;
    private bool _saving;
    private bool _includeInactive;

    private string _newName = string.Empty;
    private int _newSize = 4;
    private decimal _newPrice;
    private int _newMin;

    private async Task OnIncludeInactiveChanged(bool value)
    {
        _includeInactive = value;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded) return;
        _loaded = true;
        try
        {
            if (!Auth.IsAuthenticated) await Auth.InitializeAsync();
            if (Auth.IsOwner) await LoadAsync();
            else
            {
                _loading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var products = await Api.GetProductsAsync(_includeInactive);
            foreach (var p in products)
                p.PricePerBlock ??= 0;
            _items = products;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync(ProductDto p)
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await Api.UpdateProductAsync(p.Id, p.PricePerBlock ?? 0, p.MinStock);
            _message = $"Updated {p.Name}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAsync(ProductDto p)
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            var result = await Api.DeleteProductAsync(p.Id);
            _message = result.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task ActivateAsync(ProductDto p)
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await Api.ActivateProductAsync(p.Id);
            _message = $"Reactivated {p.Name}.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task AddAsync()
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await Api.CreateProductAsync(_newName, _newSize, _newPrice, _newMin);
            _message = "Product added.";
            _newName = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
